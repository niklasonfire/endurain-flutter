[Unit]
Description=Ephemeral GitHub runner for niklasonfire/endurain-flutter

[Service]
ExecStartPre=-/usr/bin/docker rm -f gh-runner-endurain-1
ExecStart=%h/ci-runners/endurain-flutter/run.sh
ExecStop=-/usr/bin/docker stop --time 60 gh-runner-endurain-1
Restart=always
RestartSec=15
TimeoutStopSec=90

[Install]
WantedBy=default.target
